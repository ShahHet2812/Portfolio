{
  "name": "portfolio-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker serving the portfolio API and static site",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "db:admin": "wrangler d1 execute portfolio --remote --file=./db/migrations/0002-admin.sql",
    "db:admin:local": "wrangler d1 execute portfolio --local --file=./db/migrations/0002-admin.sql",
    "test:reviews": "node --test tests/reviews.test.mjs",
    "db:reviews:local": "wrangler d1 execute portfolio --local --file=./db/migrations/0001-testimonial-submissions.sql",
    "db:reviews": "wrangler d1 execute portfolio --remote --file=./db/migrations/0001-testimonial-submissions.sql",
    "dev": "wrangler dev",
    "build:site": "npm --prefix ../frontend run build",
    "deploy": "npm run build:site && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute portfolio --local --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute portfolio --local --file=./db/seed.sql",
    "db:migrate": "wrangler d1 execute portfolio --remote --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute portfolio --remote --file=./db/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.3",
    "wrangler": "^4.129.0"
  }
}
