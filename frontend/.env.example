# Copy to .env and adjust. Vite only exposes variables prefixed with VITE_.

# Base URL of the API — no trailing slash.
#
# In production the Cloudflare Worker serves both the React app and the API
# from the same origin, so a relative path is all that's needed:
VITE_API_URL=/api

# For local development against `wrangler dev` (from the worker/ directory),
# point at the Worker instead:
# VITE_API_URL=http://localhost:8787/api
