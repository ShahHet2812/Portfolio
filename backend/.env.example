# Copy to .env and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
PORT=5000

# --- Contact form email notifications -------------------------------------
# Gmail SMTP. SMTP_PASS must be a 16-character Google App Password, NOT your
# normal Google password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first).
SMTP_USER=shahhet28122004@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where contact-form notifications are delivered.
NOTIFY_EMAIL=shahhet28122004@gmail.com

# Shown in the notification email subject/header.
SITE_NAME=hetshah.xyz

# --- Optional hardening ---------------------------------------------------
# Comma-separated list of allowed browser origins. Leave blank to allow all.
# ALLOWED_ORIGINS=https://www.hetshah.xyz,https://hetshah.xyz
